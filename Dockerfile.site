# slides.nourgaser.com: the course index plus every deck as a PDF.
#
# Stage 1 exports the PDFs in Playwright's image, whose Chromium matches the
# playwright-chromium version in bun.lock (bump the tag together with it).
# Stage 2 serves the result as static files. Rebuild to pick up new decks.
FROM mcr.microsoft.com/playwright:v1.63.0-noble AS build

COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run export:all && bun scripts/build-site.ts

FROM nginx:alpine
COPY scripts/site-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/site /usr/share/nginx/html
