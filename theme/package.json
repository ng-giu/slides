{
  "name": "slidev-theme-giu",
  "version": "0.1.0",
  "type": "module",
  "keywords": ["slidev-theme", "slidev", "giu"],
  "engines": { "slidev": ">=51.0.0" },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "routerMode": "hash",
      "canvasWidth": 980,
      "highlighter": "shiki",
      "lineNumbers": true,
      "fonts": { "sans": "Poppins", "mono": "JetBrains Mono", "weights": "300,400,500,600" }
    }
  }
}
